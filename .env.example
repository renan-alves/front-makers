# Google Analytics (Opcional)
# Obtenha seu ID em: https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL (para produção)
NEXT_PUBLIC_SITE_URL=https://frontmakers.com

