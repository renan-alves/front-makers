// Prisma Schema for Frontmakers
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model
// Open community profile model
model User {
  id          String       @id @default(cuid())
  name        String
  profession  String?
  email       String       @unique
  avatar      String?
  bio         String?
  state       String
  country     String
  newsletterOptIn Boolean  @default(false)
  passwordHash String
  articles    Article[]
  threads     Thread[]
  replies     Reply[]
  threadVotes ThreadVote[]
  replyVotes  ReplyVote[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([email])
}

// Article Model
// Main content model for published articles
model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  content     String        @db.Text
  excerpt     String
  coverImage  String?
  locale      String        @default("en")
  status      ArticleStatus @default(DRAFT)
  category    String
  readTime    Int           // Reading time in minutes
  tags        String[]      // Array of tags
  author      User          @relation(fields: [authorId], references: [id])
  authorId    String
  threads     Thread[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?

  @@index([slug])
  @@index([locale])
  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
}

model Thread {
  id             String       @id @default(cuid())
  title          String
  body           String       @db.Text
  article        Article      @relation(fields: [articleId], references: [id])
  articleId      String
  author         User         @relation(fields: [authorId], references: [id])
  authorId       String
  replies        Reply[]
  votes          ThreadVote[]
  acceptedReplyId String?
  isLocked       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([articleId])
  @@index([authorId])
  @@index([createdAt])
}

model Reply {
  id         String      @id @default(cuid())
  body       String      @db.Text
  thread     Thread      @relation(fields: [threadId], references: [id])
  threadId   String
  author     User        @relation(fields: [authorId], references: [id])
  authorId   String
  votes      ReplyVote[]
  isBestAnswer Boolean   @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([threadId])
  @@index([authorId])
  @@index([createdAt])
}

model ThreadVote {
  id        String   @id @default(cuid())
  thread    Thread   @relation(fields: [threadId], references: [id])
  threadId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  value     Int
  createdAt DateTime @default(now())

  @@unique([threadId, userId])
  @@index([threadId])
  @@index([userId])
}

model ReplyVote {
  id        String   @id @default(cuid())
  reply     Reply    @relation(fields: [replyId], references: [id])
  replyId   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  value     Int
  createdAt DateTime @default(now())

  @@unique([replyId, userId])
  @@index([replyId])
  @@index([userId])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

// Article Submission Model
// For community-submitted articles awaiting review
model ArticleSubmission {
  id          String           @id @default(cuid())
  title       String
  content     String           @db.Text
  authorName  String
  authorEmail String
  locale      String           @default("en")
  status      SubmissionStatus @default(PENDING)
  category    String?
  tags        String[]         @default([])
  notes       String?          // Admin notes
  createdAt   DateTime         @default(now())
  reviewedAt  DateTime?

  @@index([status])
  @@index([authorEmail])
  @@index([createdAt])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}
